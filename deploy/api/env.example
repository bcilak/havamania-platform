# api.havamania.com ortam dosyası şablonu. Sunucuda /opt/havamania-api/.env olarak kopyalanır, chmod 600.
# Bu dosyaya gerçek değer yazıp depoya EKLEMEYİN.
# APP_ENV, DEBUG, DATABASE_URL ve GOOGLE_APPLICATION_CREDENTIALS docker-compose.yml'de sabitlenir; burada tanımlamayın.

# --- Sunucuda üretilir (DEPLOY-API.md, adım 3) ---
SECRET_KEY=
METRICS_SECRET=
POSTGRES_PASSWORD=

# --- Platform köprüsü ---
CHATBOT_BASE_URL=https://havamania.com/api/bridge
# havamania.com panelinde Yayın › Gömme › Mobil backend köprüsü bölümünden üretilir; doğrudan buraya yapıştırılır.
CHATBOT_API_KEY=
CHATBOT_TIMEOUT_SECONDS=50
# Rıza metni ve sürümleri platformdaki GET /api/bridge/consent ucundan alınır (panel › KVKK).
# Kullanıcı başına onay ve geri çekme kaydı backend'in kendi veritabanında tutulur.
ASSISTANT_CONSENT_SOURCE=platform
CHATBOT_FREE_DAILY_LIMIT=10
CHATBOT_PREMIUM_DAILY_LIMIT=100

# --- Firebase (Android uygulamasıyla birebir aynı proje; ilk kullanıcıdan sonra DEĞİŞTİRİLMEZ) ---
FIREBASE_PROJECT_ID=havamania-be3df
# Firebase Console › Storage'daki tam bucket adı (mobil ekipten).
FIREBASE_STORAGE_BUCKET=

# --- Hesap silme: Firestore/Storage kuralları ve 5 dakikalık görev kurulup test hesabıyla doğrulanınca true ---
ACCOUNT_DELETION_ENABLED=false

# --- İsteğe bağlı ---
SENTRY_DSN_BACKEND=
