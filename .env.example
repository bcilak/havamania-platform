# --- Zorunlu ---
DATABASE_URL=postgres://havamania:havamania_dev@localhost:5544/havamania
# Oturum çerezlerini ve widget oturumlarını imzalar. En az 32 karakter.
SESSION_SECRET=
# API anahtarlarını veritabanında AES-256-GCM ile şifreler. 32 baytın base64 hali.
# Değiştirirseniz kayıtlı sağlayıcı anahtarlarını yeniden girmeniz gerekir.
ENCRYPTION_KEY=
# Uygulamanın dışarıdan erişilen adresi (gömme kodları ve imzalı dosya linkleri için).
APP_URL=http://localhost:3110

# --- İlk kurulumda oluşturulacak süper admin ---
ADMIN_EMAIL=admin@havamania.local
ADMIN_PASSWORD=

# --- Dosya deposu ---
# local: dosyalar STORAGE_LOCAL_DIR altında tutulur. s3: S3 uyumlu depo (AWS S3, Cloudflare R2, MinIO).
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
CRON_SECRET=

# --- Hız sınırları (dakika başına; isteğe bağlı) ---
# Ters vekil (nginx/Cloudflare) arkasında gerçek IP için X-Forwarded-For iletilmeli.
RATE_LIMIT_SESSION_PER_MIN=20
RATE_LIMIT_CHAT_PER_MIN=30
RATE_LIMIT_CHAT_PER_USER_PER_MIN=8
RATE_LIMIT_UPLOAD_PER_MIN=10
RATE_LIMIT_FEEDBACK_PER_MIN=30

# --- Yalnızca docker-compose.prod.yml ---
POSTGRES_PASSWORD=

# Canlı sunucuda uygulamanın dinleyeceği yerel port (docker-compose.prod.yml)
APP_PORT=3000
